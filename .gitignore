# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
pip-wheel-metadata/
MANIFEST

# ── Virtual environments ──────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── Environment / secrets ─────────────────────────────────
.env
# keep example
!.env.example
!backend/.env.example

# ── Database ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/rpt.db

# ── Logs ─────────────────────────────────────────────────
*.log
logs/
log.log

# ── Node.js / Frontend ────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ── Test / Coverage ───────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
*.cover

# ── IDEs ──────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────
.dockerignore

# ── Outputs / temp ────────────────────────────────────────
outputs/
.cache
.cache/
*.zip
*.tar.gz
*.tmp
tmp/

# ── Large model files (mount at runtime) ─────────────────
model/.lock/
model/Qwen/
model/*/pytorch_model*.bin
model/*/model*.safetensors
model/*/*.pt

# ── vLLM source directory ─────────────────────────────────
vllm-0.18.1rc0/
vllm-0.23.0/
vllm-main/
sglang-main/

# ── Mirror source dirs for vllm / sglang ──────────────────
.magic/

# ── Local agent/tooling config ─────────────────────────────
.superpowers/
.codex/
.claude/
.agents/
.worktrees/
.omc/

# ── SQLite WAL files ──────────────────────────────────────
*.db-shm
*.db-wal

# ── Benchmark 运行产物（auto_bench run 目录 / 归档 / pid）──不入库 ─
# 已跟踪的结果文件（顶层 CSV/XLSX 等）不受影响；仅拦新增的 run 目录与归档。
vllm_standalone_bench/results/*/
*.tar
*.pid
