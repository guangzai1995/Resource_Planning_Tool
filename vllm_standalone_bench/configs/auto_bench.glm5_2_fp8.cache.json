        "--enable-expert-parallel",
        "--kv-cache-dtype",
        "fp8"
      ]
    },
    {
      "name": "all_fp8_no_moe_ep",
      "gpus": "all",
      "cache_key": "glm52-fp8-no-moep-tp8-all-latest0616-kvfp8-mtp5-len150k-prefix",
      "args": [
        "--tensor-parallel-size",
        "8",
        "--max-model-len",
        "149999",
        "--max-num-seqs",
        "48",
        "--enable-prefix-caching",
        "--tool-call-parser",
        "glm47",
