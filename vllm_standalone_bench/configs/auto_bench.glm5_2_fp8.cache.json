{
  "run": {
    "name": "offline_full_bench_glm52_fp8_compare",
    "results_dir": "vllm_standalone_bench/results",
    "vllm_image": "vllm/vllm-openai:latest-0616",
    "bench_image": "vllm-bench-runner:offline",
    "network": "vllm-bench-net",
    "create_network": true,
    "cleanup_network": true,
    "container_port": 8004,
    "publish_host_port": false,
    "host_port": 18000,
    "api_key": "local-bench-key",
    "ready_timeout_sec": 3600,
    "cooldown_sec": 20,
    "vllm_cache": {
      "enabled": true,
      "root": "../.cache/vllm_auto_bench",
      "container_path": "/vllm-cache",
      "set_default_env": true
    }
  },
  "mounts": {
    "models": "/NVME4/models"
  },
  "models": [
    {
      "name": "GLM-5.2",
      "model_path": "/models/GLM-5.2-FP8",
      "tokenizer_path": "/models/GLM-5.2-FP8",
      "served_model_name": "GLM-5.2"
    }
  ],
  "serve_profiles": [
    {
      "name": "all_fp8_default",
      "gpus": "all",
      "cache_key": "glm52-fp8-tp8-all-latest0616-ep-mtp5-len150k-prefix",
      "args": [
        "--tensor-parallel-size",
        "8",
        "--max-model-len",
        "149999",
        "--max-num-seqs",
        "48",
        "--enable-prefix-caching",
        "--tool-call-parser",
        "glm47",
        "--reasoning-parser",
        "glm45",
        "--enable-auto-tool-choice",
        "--chat-template-content-format",
        "string",
        "--trust-remote-code",
        "--enable-force-include-usage",
        "--enable-prompt-tokens-details",
        "--enable-log-requests",
        "--enable-expert-parallel",
        "--kv-cache-dtype",
        "fp8",
        "--speculative-config.method",
        "mtp",
        "--speculative-config.num_speculative_tokens",
        "5"
      ]
    },
    {
      "name": "all_fp8_no_kv_fp8",
      "gpus": "all",
      "cache_key": "glm52-fp8-no-kvfp8-tp8-all-latest0616-ep-mtp5-len150k-prefix",
      "args": [
        "--tensor-parallel-size",
        "8",
        "--max-model-len",
        "149999",
        "--max-num-seqs",
        "48",
        "--enable-prefix-caching",
        "--tool-call-parser",
        "glm47",
        "--reasoning-parser",
        "glm45",
        "--enable-auto-tool-choice",
        "--chat-template-content-format",
        "string",
        "--trust-remote-code",
        "--enable-force-include-usage",
        "--enable-prompt-tokens-details",
        "--enable-log-requests",
        "--enable-expert-parallel",
        "--speculative-config.method",
        "mtp",
        "--speculative-config.num_speculative_tokens",
        "5"
      ]
    },
    {
      "name": "all_fp8_no_spec_decode",
      "gpus": "all",
      "cache_key": "glm52-fp8-no-spec-tp8-all-latest0616-ep-kvfp8-len150k-prefix",
      "args": [
        "--tensor-parallel-size",
        "8",
        "--max-model-len",
        "149999",
        "--max-num-seqs",
        "48",
        "--enable-prefix-caching",
        "--tool-call-parser",
        "glm47",
        "--reasoning-parser",
        "glm45",
        "--enable-auto-tool-choice",
        "--chat-template-content-format",
        "string",
        "--trust-remote-code",
        "--enable-force-include-usage",
        "--enable-prompt-tokens-details",
