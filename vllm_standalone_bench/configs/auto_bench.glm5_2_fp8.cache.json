    {
      "name": "all_fp8_mtp3",
      "gpus": "all",
      "cache_key": "glm52-fp8-tp8-all-latest0616-ep-mtp3-len150k-prefix",
      "args": [
        "--tensor-parallel-size",
        "8",
        "--max-model-len",
        "149999",
        "--max-num-seqs",
        "48",
        "--enable-prefix-caching",
        "--tool-call-parser",
        "glm47",
        "--reasoning-parser",
        "glm45",
        "--enable-auto-tool-choice",
        "--chat-template-content-format",
        "string",
        "--trust-remote-code",
        "--enable-force-include-usage",
        "--enable-prompt-tokens-details",
        "--enable-log-requests",
        "--enable-expert-parallel",
        "--kv-cache-dtype",
        "fp8",
        "--speculative-config.method",
        "mtp",
        "--speculative-config.num_speculative_tokens",
        "3"
      ]
    }
  ],
  "bench_profiles": [
    {
      "name": "latency_matrix",
      "backend": "openai-chat",
      "input_lens": [4096, 8192, 16384, 32768, 65536, 131072],
      "output_lens": [1024],
      "parallel_nums": [1, 4, 8, 16, 24, 32],
      "epochs": 3,
      "prefix_ratio": 0.65,
      "warmup_requests": 8,
      "cross_product": true,
      "max_ttft_ms": 15000,
      "min_throughput_tok_s": 5,
      "min_output_compliance": 0.95
    }
  ]
}
