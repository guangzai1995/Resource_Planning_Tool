        "--speculative-config.num_speculative_tokens",
        "5"
      ]
    },
    {
      "name": "all_fp8_no_prefix_cache",
      "gpus": "all",
      "cache_key": "glm52-fp8-no-prefix-tp8-all-latest0616-ep-kvfp8-mtp5-len150k",
      "args": [
        "--tensor-parallel-size",
        "8",
        "--max-model-len",
        "149999",
        "--max-num-seqs",
        "48",
        "--no-enable-prefix-caching",
        "--tool-call-parser",
        "glm47",
        "--reasoning-parser",
        "glm45",
        "--enable-auto-tool-choice",
        "--chat-template-content-format",
        "string",
        "--trust-remote-code",
        "--enable-force-include-usage",
        "--enable-prompt-tokens-details",
        "--enable-log-requests",
        "--enable-expert-parallel",
        "--kv-cache-dtype",
        "fp8",
        "--speculative-config.method",
        "mtp",
        "--speculative-config.num_speculative_tokens",
        "5"
      ]
    },
    {
      "name": "all_fp8_all_opts_off",
      "gpus": "all",
      "cache_key": "glm52-fp8-allopts-off-tp8-all-latest0616-len150k",
      "args": [
        "--tensor-parallel-size",
        "8",
        "--max-model-len",
        "149999",
        "--max-num-seqs",
        "48",
        "--no-enable-prefix-caching",
        "--tool-call-parser",
        "glm47",
        "--reasoning-parser",
        "glm45",
        "--enable-auto-tool-choice",
