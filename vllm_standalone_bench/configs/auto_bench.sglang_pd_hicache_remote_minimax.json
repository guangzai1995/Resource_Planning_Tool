{
  "run": {
    "name": "sglang_minimax_m27_pd_hicache_compare",
    "results_dir": "vllm_standalone_bench/results",
    "bench_image": "vllm-bench-runner:offline",
    "api_key": "local-bench-key",
    "ready_timeout_sec": 3600,
    "cooldown_sec": 20
  },
  "mounts": {
    "models": "/NVME1/models"
  },
  "models": [
    {
      "name": "MINIMAX-M2.7",
      "model_path": "/models/MiniMax-M2.7-NVFP4",
      "tokenizer_path": "/models/MiniMax-M2.7-NVFP4",
      "served_model_name": "minimax-m2.7"
    }
  ],
  "topology_profiles": [
    {
      "name": "sglang_pd_hicache_minimax_m27_2p2d",
      "engine": "sglang",
      "mode": "pd",
      "provider": "ssh_docker",
      "network": "host",
      "transfer_backend": "mooncake",
      "disaggregation_ib_device": "mlx5_0",
      "mount_infiniband": true,
      "image": "lmsysorg/sglang:latest",
      "router_image": "sglang-router:offline",
      "sglang_hicache": {
        "mode": "full_async_offload",
        "page_size": 64,
        "io_backend": "direct",
        "mem_layout": "page_first_direct",
        "storage_backend": "mooncake",
        "storage_backend_extra_config": {
          "tp_lcm_size": 4
        }
      },
      "env": {
        "MOONCAKE_MASTER": "10.200.1.10:50051",
        "MOONCAKE_TE_META_DATA_SERVER": "http://10.200.1.10:8080/metadata",
        "MOONCAKE_PROTOCOL": "rdma",
        "MOONCAKE_DEVICE": "mlx5_0",
        "MOONCAKE_GLOBAL_SEGMENT_SIZE": "64gb"
      },
      "hosts": {
        "p1": {"address": "10.200.1.13", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "p2": {"address": "10.200.1.13", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "d1": {"address": "10.200.1.14", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "d2": {"address": "10.200.1.14", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "router": {"address": "10.200.1.14", "ssh_user": "aipaas_test", "auth": {"type": "key"}}
      },
      "prefill": [
        {
          "name": "p1",
          "host": "p1",
          "port": 4137,
          "bootstrap_port": 12335,
          "gpus": "0,1,2,3",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        },
        {
          "name": "p2",
          "host": "p2",
          "port": 4138,
          "bootstrap_port": 12336,
          "gpus": "4,5,6,7",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        }
      ],
      "decode": [
        {
          "name": "d1",
          "host": "d1",
          "port": 4137,
          "gpus": "0,1,2,3",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        },
        {
          "name": "d2",
          "host": "d2",
          "port": 4138,
          "gpus": "4,5,6,7",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        }
      ],
      "frontend": {
        "kind": "sglang_router",
        "host": "router",
        "port": 18000,
        "args": [
          "--prefill-policy", "cache_aware",
          "--decode-policy", "power_of_two"
        ]
      }
    },
    {
      "name": "sglang_pd_hicache_minimax_m27_prefill_only_2p2d",
      "engine": "sglang",
      "mode": "pd",
      "provider": "ssh_docker",
      "network": "host",
      "transfer_backend": "mooncake",
      "disaggregation_ib_device": "mlx5_0",
      "mount_infiniband": true,
      "image": "lmsysorg/sglang:latest",
      "router_image": "sglang-router:offline",
      "sglang_hicache": {
        "mode": "prefill_only",
        "page_size": 64,
        "io_backend": "direct",
        "mem_layout": "page_first_direct",
        "storage_backend": "mooncake",
        "storage_backend_extra_config": {
          "tp_lcm_size": 4
        }
      },
      "env": {
        "MOONCAKE_MASTER": "10.200.1.10:50051",
        "MOONCAKE_TE_META_DATA_SERVER": "http://10.200.1.10:8080/metadata",
        "MOONCAKE_PROTOCOL": "rdma",
        "MOONCAKE_DEVICE": "mlx5_0",
        "MOONCAKE_GLOBAL_SEGMENT_SIZE": "64gb"
      },
      "hosts": {
        "p1": {"address": "10.200.1.13", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "p2": {"address": "10.200.1.13", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "d1": {"address": "10.200.1.14", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "d2": {"address": "10.200.1.14", "ssh_user": "aipaas_test", "auth": {"type": "key"}},
        "router": {"address": "10.200.1.14", "ssh_user": "aipaas_test", "auth": {"type": "key"}}
      },
      "prefill": [
        {
          "name": "p1",
          "host": "p1",
          "port": 4237,
          "bootstrap_port": 12435,
          "gpus": "0,1,2,3",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        },
        {
          "name": "p2",
          "host": "p2",
          "port": 4238,
          "bootstrap_port": 12436,
          "gpus": "4,5,6,7",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        }
      ],
      "decode": [
        {
          "name": "d1",
          "host": "d1",
          "port": 4237,
          "gpus": "0,1,2,3",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        },
        {
          "name": "d2",
          "host": "d2",
          "port": 4238,
          "gpus": "4,5,6,7",
          "args": [
            "--tensor-parallel-size", "4",
            "--trust-remote-code",
            "--mem-fraction-static", "0.85",
            "--max-running-requests", "128",
            "--context-length", "172032",
            "--stream-response-default-include-usage"
          ]
        }
      ],
      "frontend": {
        "kind": "sglang_router",
        "host": "router",
        "port": 18001,
        "args": [
          "--prefill-policy", "cache_aware",
          "--decode-policy", "power_of_two"
        ]
      }
    }
  ],
  "bench_profiles": [
    {
      "name": "hicache_long_prompt_reuse",
      "backend": "openai-chat",
      "input_lens": [4096, 8192, 16384],
      "output_lens": [1024],
      "parallel_nums": [16, 32, 64],
      "epochs": 3,
      "prefix_ratio": 0.8,
      "warmup_requests": 4,
      "warmup_concurrency": 8,
      "cross_product": true,
      "max_ttft_ms": 15000,
      "min_throughput_tok_s": 5,
      "min_output_compliance": 0.95
    }
  ]
}
