{
  "run": {
    "name": "openai-completion-smoke",
    "requests": 4,
    "concurrency": 2,
    "warmup_requests": 0,
    "request_timeout_sec": 30,
    "output_dir": "reports/openai-completion-smoke"
  },
  "target": {
    "type": "openai-completion",
    "base_url": "http://127.0.0.1:8000",
    "endpoint": "/v1/completions",
    "model": "demo-completion-model",
    "headers": {},
    "extra_body": {
      "max_tokens": 32,
      "temperature": 0
    }
  },
  "dataset": {
    "type": "jsonl",
    "path": "datasets/text_prompts.example.jsonl"
  }
}
