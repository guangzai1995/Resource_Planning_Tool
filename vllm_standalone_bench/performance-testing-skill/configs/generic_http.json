{
  "run": {
    "name": "generic-http-smoke",
    "requests": 4,
    "concurrency": 2,
    "warmup_requests": 0,
    "request_timeout_sec": 30,
    "output_dir": "reports/generic-http-smoke"
  },
  "target": {
    "type": "generic-http",
    "base_url": "http://127.0.0.1:8000",
    "endpoint": "/score",
    "method": "POST",
    "headers": {},
    "body_template": {
      "prompt": "{prompt}",
      "case": "{case}",
      "source": "performance-testing-skill"
    }
  },
  "dataset": {
    "type": "jsonl",
    "path": "datasets/text_prompts.example.jsonl"
  }
}
