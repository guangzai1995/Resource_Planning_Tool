# Dockerfile.sglang-router — SGLang PD 的 Python router 镜像
#
# 注意: 这不是 Rust 的 sgl-router 二进制镜像!
# auto_bench harness 用 `python3 -m sglang_router.launch_router` 起 router,
# 所以镜像里要有 python3 + sglang_router(Python 包, pip install sglang-router)。
# sglang-router 在 PyPI 上是带预编译 Rust 库的 wheel, pip 装即可, 不需要本地 Rust/cargo/github。
#
# 构建:
#   docker build -f Dockerfile.sglang-router -t sglang-router:offline .
# 内网/PyPI 镜像源:
#   docker build -f Dockerfile.sglang-router -t sglang-router:offline \
#     --build-arg PIP_INDEX_URL=https://<pypi-mirror>/simple .

FROM python:3.12-slim

ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST

# 若指定了镜像源, 透传给 pip
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
RUN if [ -n "$PIP_INDEX_URL" ]; then pip config set global.index-url "$PIP_INDEX_URL"; fi \
 && if [ -n "$PIP_EXTRA_INDEX_URL" ]; then pip config set global.extra-index-url "$PIP_EXTRA_INDEX_URL"; fi \
 && if [ -n "$PIP_TRUSTED_HOST" ]; then pip config set global.trusted-host "$PIP_TRUSTED_HOST"; fi \
 && pip install --no-cache-dir sglang-router

# harness: --entrypoint python3 <image> -m sglang_router.launch_router ...
CMD ["python3", "-m", "sglang_router.launch_router", "--help"]
