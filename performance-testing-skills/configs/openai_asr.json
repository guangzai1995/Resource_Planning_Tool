{
  "protocol": "openai_asr",
  "base_url": "http://127.0.0.1:8000/v1",
  "model": "example-asr-model",
  "headers": {
    "Authorization": "Bearer ${API_KEY}"
  },
  "dataset": {
    "type": "audio_manifest",
    "path": "datasets/audio_manifest.example.jsonl"
  },
  "bench": {
    "concurrency": [1, 4, 8],
    "epochs": 3,
    "timeout": 60
  },
  "report": {
    "formats": ["json", "csv", "md"]
  }
}
